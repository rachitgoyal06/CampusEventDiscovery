{
  "version": 2,
  "builds": [
    {
      "src": "backend/Dockerfile",
      "use": "@vercel/docker",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/build" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/Dockerfile", "methods": ["GET","POST","PUT","DELETE"] },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
